<section class="trust" aria-label="Nos garanties">
  <ul class="page-width trust__list">
    {%- for block in section.blocks -%}
      <li class="trust__item" {{ block.shopify_attributes }}>
        <span class="trust__icon">{%- render 'icon', name: block.settings.icon -%}</span>
        <span>{{ block.settings.text | escape }}</span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Barre de confiance",
  "max_blocks": 4,
  "blocks": [
    { "type": "item", "name": "Élément", "settings": [
      { "type": "select", "id": "icon", "label": "Icône", "default": "truck", "options": [
        { "value": "truck", "label": "Camion" }, { "value": "return", "label": "Retour" }, { "value": "lock", "label": "Cadenas" },
        { "value": "mail", "label": "E-mail" }, { "value": "gift", "label": "Cadeau" }, { "value": "star", "label": "Étoile" } ] },
      { "type": "text", "id": "text", "label": "Mot", "default": "Livraison" }
    ] }
  ],
  "presets": [{
    "name": "Barre de confiance",
    "blocks": [
      { "type": "item", "settings": { "icon": "truck", "text": "Livraison offerte" } },
      { "type": "item", "settings": { "icon": "return", "text": "Retours 14 jours" } },
      { "type": "item", "settings": { "icon": "lock", "text": "Paiement sécurisé" } },
      { "type": "item", "settings": { "icon": "mail", "text": "Service client" } }
    ]
  }]
}
{% endschema %}
