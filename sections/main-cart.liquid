<div class="page-hero"><div class="page-width"><h1>Ton panier</h1></div></div>
<section class="section">
  <div class="page-width" style="max-width:820px">
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="box">
        {%- for item in cart.items -%}
          <div class="line">
            {%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: alt: item.product.title, loading: 'lazy' }}{%- else -%}<span></span>{%- endif -%}
            <div>
              <a class="line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
              <label for="Updates-{{ forloop.index }}" class="visually-hidden">Quantité</label>
              <input class="field" style="width:80px;min-height:40px;border:2px solid var(--border);border-radius:10px;padding:4px 8px" type="number" id="Updates-{{ forloop.index }}" name="updates[]" value="{{ item.quantity }}" min="0">
              <div><a class="line__remove" href="{{ item.url_to_remove }}">Retirer</a></div>
            </div>
            <div class="line__price">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
        {%- if cart.total_discount > 0 -%}<div class="drawer__row drawer__row--discount" style="margin-top:16px"><span>Remise</span><span>−{{ cart.total_discount | money }}</span></div>{%- endif -%}
        <div class="drawer__row" style="margin-top:16px"><span>Total TTC</span><span>{{ cart.total_price | money }}</span></div>
        <p class="drawer__note">Frais de livraison calculés à l'étape suivante.</p>
        <div class="help-links" style="justify-content:flex-end">
          <button type="submit" name="update" class="btn btn--outline">Mettre à jour</button>
          <button type="submit" name="checkout" class="btn btn--primary">Commander</button>
        </div>
      </form>
    {%- else -%}
      <p class="section-intro">Ton panier est vide pour l'instant.</p>
      <div class="help-links"><a href="{%- render 'gifts-url' -%}" class="btn btn--primary">Découvrir la boutique</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Panier", "settings": [] }
{% endschema %}
