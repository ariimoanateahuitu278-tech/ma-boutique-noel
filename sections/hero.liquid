{%- liquid
  assign hero_product = section.settings.product
  if hero_product == blank
    assign hero_product = collections['idees-cadeaux'].products.first | default: collections.all.products.first
  endif
  assign hero_image = section.settings.image
  if hero_image == blank and hero_product
    assign hero_image = hero_product.featured_image
  endif
  assign thumb_image = section.settings.thumb_image | default: hero_product.featured_image
  capture gifts_url
    render 'gifts-url'
  endcapture
  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank
    assign has_video = true
  endif
-%}
<section class="hero" aria-labelledby="HeroTitle-{{ section.id }}">
  {%- render 'baubles', class: 'hero__baubles', count: 7 -%}
  <div class="page-width hero__inner">
    <div class="hero__content">
      <p class="hero__kicker">{%- render 'icon', name: 'tree' -%}<span>{{ section.settings.kicker | escape }}</span></p>
      <h1 id="HeroTitle-{{ section.id }}">{{ section.settings.title | escape }}</h1>
      <p class="hero__text">{{ section.settings.text | escape }}</p>
      <div class="hero__buttons">
        <span class="snow-btn">
          {%- render 'snowman' -%}
          <a href="{{ section.settings.button_1_link | default: gifts_url }}" class="btn btn--white btn--lg">{{ section.settings.button_1_label | escape }}</a>
        </span>
        <span class="snow-btn">
          {%- render 'snowman' -%}
          <a href="{{ section.settings.button_2_link | default: routes.all_products_collection_url | append: '?sort_by=created-descending' }}" class="btn btn--outline-light btn--lg">{{ section.settings.button_2_label | escape }}</a>
        </span>
      </div>
      <ul class="hero__pills">
        {%- if section.settings.pill_1 != blank -%}<li class="pill pill--light">{%- render 'icon', name: 'truck' -%}{{ section.settings.pill_1 | escape }}</li>{%- endif -%}
        {%- if section.settings.pill_2 != blank -%}<li class="pill pill--light">{%- render 'icon', name: 'return' -%}{{ section.settings.pill_2 | escape }}</li>{%- endif -%}
        {%- if section.settings.pill_3 != blank -%}<li class="pill pill--light">{%- render 'icon', name: 'lock' -%}{{ section.settings.pill_3 | escape }}</li>{%- endif -%}
      </ul>
    </div>

    <div class="hero__media">
      <div class="hero__photo">
        {%- if hero_image -%}
          {{ hero_image | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 560px, 100vw', alt: section.settings.image_alt | default: hero_image.alt | default: hero_product.title }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="hero__aside">
        {%- if hero_product and thumb_image -%}
          <a href="{{ hero_product.url }}" class="hero__thumb">
            {{ thumb_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'eager', alt: hero_product.title }}
            <span>{{ hero_product.title | escape }}<br><span style="font-weight:900">{{ hero_product.price | money }} TTC</span></span>
          </a>
        {%- endif -%}
        {%- if has_video -%}
          <button type="button" class="hero__video" data-video-open="HeroVideo-{{ section.id }}">
            <span class="hero__video-play">{%- render 'icon', name: 'play' -%}</span>
            <span>Voir le produit en action</span>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{%- if has_video -%}
  <div class="video-modal" id="HeroVideo-{{ section.id }}" role="dialog" aria-modal="true" aria-label="Vidéo de démonstration">
    <div class="video-modal__inner">
      <button type="button" class="video-modal__close" data-video-close>Fermer ✕</button>
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: controls: true, playsinline: true, preload: 'none' }}
      {%- else -%}
        <template data-video-template>
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe src="https://www.youtube-nocookie.com/embed/{{ section.settings.video_url.id }}?autoplay=1&rel=0" allow="autoplay; encrypted-media" allowfullscreen title="Vidéo de démonstration"></iframe>
          {%- else -%}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" allow="autoplay; fullscreen" allowfullscreen title="Vidéo de démonstration"></iframe>
          {%- endif -%}
        </template>
        <div data-video-slot></div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Surtitre", "default": "Noël Magique" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Des idées cadeaux qui font briller les yeux" },
    { "type": "textarea", "id": "text", "label": "Phrase", "default": "Des cadeaux originaux, choisis avec soin, pour faire plaisir à Noël sans te prendre la tête." },
    { "type": "text", "id": "button_1_label", "label": "Bouton 1", "default": "Découvrir la boutique" },
    { "type": "url", "id": "button_1_link", "label": "Lien du bouton 1" },
    { "type": "text", "id": "button_2_label", "label": "Bouton 2", "default": "Voir les nouveautés" },
    { "type": "url", "id": "button_2_link", "label": "Lien du bouton 2" },
    { "type": "header", "content": "Pastilles (informations vraies uniquement)" },
    { "type": "text", "id": "pill_1", "label": "Pastille 1", "default": "Livraison offerte" },
    { "type": "text", "id": "pill_2", "label": "Pastille 2", "default": "Retours 14 jours" },
    { "type": "text", "id": "pill_3", "label": "Pastille 3", "default": "Paiement sécurisé" },
    { "type": "header", "content": "Photo et produit" },
    { "type": "product", "id": "product", "label": "Produit mis en avant" },
    { "type": "image_picker", "id": "image", "label": "Grande photo (idéalement le produit en situation)", "info": "Sans texte ni badge sur la photo. Par défaut : photo principale du produit mis en avant." },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif de la grande photo" },
    { "type": "image_picker", "id": "thumb_image", "label": "Vignette ronde (le produit seul)" },
    { "type": "header", "content": "Vidéo « Voir le produit en action »" },
    { "type": "paragraph", "content": "La vignette vidéo ne s'affiche que si une vidéo est ajoutée ici." },
    { "type": "video", "id": "video", "label": "Vidéo hébergée sur Shopify" },
    { "type": "video_url", "id": "video_url", "label": "Ou lien YouTube / Vimeo", "accept": ["youtube", "vimeo"] }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
