<div class="announcement" role="region" aria-label="Annonce">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
  <span>{{ section.settings.text_1 | escape }}</span>
  {%- if section.settings.text_2 != blank -%}<span class="announcement__sep" aria-hidden="true">✦</span><span>{{ section.settings.text_2 | escape }}</span>{%- endif -%}
  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</div>

{% schema %}
{
  "name": "Bandeau d'annonce",
  "settings": [
    { "type": "paragraph", "content": "N'affiche que des informations vraies. « Livraison offerte » suppose que la livraison est réglée à 0 € dans Paramètres > Expédition et livraison." },
    { "type": "text", "id": "text_1", "label": "Texte 1", "default": "🎁 Livraison offerte" },
    { "type": "text", "id": "text_2", "label": "Texte 2", "default": "Retours sous 14 jours" },
    { "type": "url", "id": "link", "label": "Lien", "default": "/pages/livraison-et-retours" }
  ]
}
{% endschema %}
