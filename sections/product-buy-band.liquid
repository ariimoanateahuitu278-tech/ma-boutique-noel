{%- liquid
  assign whop_1 = product.metafields.custom.lien_whop.value
  assign use_whop = false
  if settings.checkout_mode == 'whop' and whop_1 != blank
    assign use_whop = true
  endif
  assign v = product.selected_or_first_available_variant
-%}
<section class="buyband" aria-labelledby="BuyBandTitle-{{ section.id }}">
  {%- render 'baubles', class: 'buyband__baubles', count: 6 -%}
  <div class="page-width buyband__inner">
    {%- if product.featured_image -%}
      <div class="buyband__img">{{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title }}</div>
    {%- endif -%}
    <div class="buyband__text">
      <h2 id="BuyBandTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2>
      <p class="buyband__name">{{ product.title | escape }}</p>
      <p class="buyband__price">{{ v.price | money }} <small>TTC</small></p>
      {%- if use_whop -%}
        <a href="{{ whop_1 }}" class="btn btn--white btn--lg" data-whop-buy rel="noopener">Acheter</a>
      {%- else -%}
        <button type="button" class="btn btn--white btn--lg" data-sticky-add{% unless v.available %} disabled{% endunless %}>Ajouter au panier</button>
      {%- endif -%}
      <ul class="buyband__reassure" role="list">
        <li>{%- render 'icon', name: 'truck' -%}Livraison suivie</li>
        <li>{%- render 'icon', name: 'return' -%}Retours sous 14 jours</li>
        <li>{%- render 'icon', name: 'lock' -%}Paiement sécurisé</li>
      </ul>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Bandeau d'achat final", "settings": [ { "type": "text", "id": "title", "label": "Titre", "default": "Prêt à le glisser sous le sapin ?" } ] }
{% endschema %}
