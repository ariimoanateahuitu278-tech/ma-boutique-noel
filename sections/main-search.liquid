<div class="page-hero">
  <div class="page-width">
    <h1>Recherche</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="max-width:560px;margin:18px auto 0">
      <label for="SearchPageInput" class="visually-hidden">Rechercher</label>
      <input type="search" id="SearchPageInput" name="q" value="{{ search.terms | escape }}" placeholder="Rechercher une idée cadeau…">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn btn--primary">Rechercher</button>
    </form>
  </div>
</div>
<section class="section">
  <div class="page-width">
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count > 0 -%}
          <p class="section-intro">{{ search.results_count }} résultat{% if search.results_count > 1 %}s{% endif %} pour « {{ search.terms | escape }} »</p>
          <h2 class="visually-hidden">Résultats</h2>
          <ul class="product-grid" role="list">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}<li>{%- render 'product-card', card_product: item -%}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="section-intro">Aucun résultat pour « {{ search.terms | escape }} ». Essaie un autre mot, ou découvre toutes nos idées cadeaux.</p>
          <div class="help-links"><a href="{%- render 'gifts-url' -%}" class="btn btn--primary">Voir les idées cadeaux</a></div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="help-links"><a href="{%- render 'gifts-url' -%}" class="btn btn--primary">Voir les idées cadeaux</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Recherche", "settings": [] }
{% endschema %}
