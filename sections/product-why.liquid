{%- liquid
  capture raw
    render 'product-text', product: product, field: 'why'
  endcapture
  assign items = raw | strip | split: '~~'
-%}
{%- if items.size > 0 -%}
<section class="section" aria-labelledby="WhyTitle-{{ section.id }}">
  <div class="page-width">
    <span class="eyebrow" style="display:block;text-align:center">{{ product.title | escape }}</span>
    <h2 class="section-title" id="WhyTitle-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    {%- if product.description != blank -%}<div class="section-intro">{{ product.description | strip_html | escape }}</div>{%- endif -%}
    <div class="why">
      {%- for item in items limit: 4 -%}
        {%- assign f = item | split: '|' -%}
        {%- assign m = nil -%}
        {%- if product.media.size > 0 -%}{%- assign mi = forloop.index0 | modulo: product.media.size -%}{%- assign m = product.media[mi] -%}{%- endif -%}
        <div class="why__row{% cycle '', ' why__row--reverse' %}" data-reveal>
          <div class="why__media why__media--crop{{ forloop.index }}">
            {%- if m -%}
              {{ m.preview_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480, 720, 1000', sizes: '(min-width: 990px) 540px, 100vw', alt: m.alt | default: product.title | append: ' – ' | append: f[1] }}
            {%- endif -%}
          </div>
          <div class="why__text">
            <span class="eyebrow">{{ f[0] }}</span>
            <h3 class="why__title">{{ f[1] }}</h3>
            <p>{{ f[2] }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{ "name": "Pourquoi l'aimer", "settings": [ { "type": "text", "id": "title", "label": "Titre", "default": "Pourquoi vous allez l'aimer" } ] }
{% endschema %}
