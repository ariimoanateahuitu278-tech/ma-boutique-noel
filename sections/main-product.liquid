{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign mf = product.metafields.custom
  assign whop_1 = mf.lien_whop.value
  assign whop_2 = mf.lien_whop_2.value
  assign whop_3 = mf.lien_whop_3.value
  assign use_whop = false
  if settings.checkout_mode == 'whop' and whop_1 != blank
    assign use_whop = true
  endif

  assign show_offers = section.settings.show_offers
  if use_whop
    if whop_2 == blank and whop_3 == blank
      assign show_offers = false
    endif
  endif

  comment
    Sélecteur de variantes : uniquement si chaque variante existe vraiment avec sa propre photo.
  endcomment
  assign show_variant_picker = false
  unless product.has_only_default_variant
    assign show_variant_picker = true
    for v in product.variants
      if v.featured_media == blank
        assign show_variant_picker = false
      endif
    endfor
  endunless

  assign price = current_variant.price
  assign price_2 = price | times: 2 | times: 0.95 | round
  assign price_3 = price | times: 3 | times: 0.90 | round

  capture vigilance
    render 'product-text', product: product, field: 'vigilance'
  endcapture
  assign vigilance = vigilance | strip
-%}

{%- render 'garland', class: 'product__garland' -%}

<section class="product page-width" data-product-section data-section-id="{{ section.id }}">
  <div class="product__grid">

    {%- comment -%} ===== Colonne gauche : galerie ===== {%- endcomment -%}
    <div class="product__gallery" data-gallery>
      <div class="gallery__main">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="gallery__slide{% if media.id == current_variant.featured_media.id or forloop.first and current_variant.featured_media == blank %} is-active{% endif %}" data-slide data-media-id="{{ media.id }}"{% if media.media_type == 'image' %} data-zoom{% endif %}>
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- else -%}{%- assign img_loading = 'lazy' -%}{%- endif -%}
                  {{ media | image_url: width: 1400 | image_tag: loading: img_loading, widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 600px, 100vw', alt: media.alt | default: product.title }}
                {%- when 'video' -%}
                  {{ media | media_tag: image_size: '1200x', controls: true, playsinline: true, preload: 'none' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
          {%- if product.media.size > 1 -%}
            <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="Photo précédente">{%- render 'icon', name: 'chevron-left' -%}</button>
            <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="Photo suivante">{%- render 'icon', name: 'chevron-right' -%}</button>
          {%- endif -%}
        {%- else -%}
          <div class="gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <ul class="gallery__thumbs" role="list">
          {%- for media in product.media -%}
            <li>
              <button type="button" class="gallery__thumb" data-thumb="{{ forloop.index0 }}" aria-label="Voir la photo {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>
                {{ media.preview_image | image_url: width: 200, height: 200, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} ===== Colonne droite : zone d'achat ===== {%- endcomment -%}
    <div class="product__info">
      <span class="eyebrow">{%- render 'product-text', product: product, field: 'eyebrow' -%}</span>
      <div class="product__title-row">
        <h1 class="product__title">{{ product.title | escape }}</h1>
        {%- render 'baubles', class: 'baubles--dark baubles--small', count: 5 -%}
      </div>
      <p class="product__hook">{%- render 'product-text', product: product, field: 'hook' -%}</p>

      <div class="product__price">
        <span class="product__price-amount" data-unit-price>{{ price | money }}</span>
        <span class="product__price-tax">{{ settings.tax_label | default: 'TTC' }}</span>
      </div>

      <ul class="benefits" role="list">
        {%- render 'product-text', product: product, field: 'benefits' -%}
        {%- if settings.free_shipping_text != blank -%}
          <li><span class="check">{%- render 'icon', name: 'check' -%}</span><span>{{ settings.free_shipping_text | escape }}</span></li>
        {%- endif -%}
        <li><span class="check">{%- render 'icon', name: 'check' -%}</span><span>Retours sous 14 jours après réception</span></li>
        <li><span class="check">{%- render 'icon', name: 'check' -%}</span><span>Paiement sécurisé</span></li>
        <li><span class="check">{%- render 'icon', name: 'check' -%}</span><span>Service client par e-mail</span></li>
      </ul>

      {%- if use_whop -%}
        {%- comment -%} Paiement via les liens Whop du produit {%- endcomment -%}
        <div data-whop-form>
          {%- if show_offers -%}
            <fieldset class="offers">
              <legend>Choisis ton offre</legend>
              <label class="offer is-selected">
                <input type="radio" name="offer-{{ section.id }}" value="{{ whop_1 }}" data-whop-offer checked>
                <span class="offer__radio" aria-hidden="true"></span>
                <span class="offer__label">1 article</span>
                <span class="offer__total">{{ price | money }}<small>TTC</small></span>
              </label>
              {%- if whop_2 != blank -%}
                <label class="offer">
                  <input type="radio" name="offer-{{ section.id }}" value="{{ whop_2 }}" data-whop-offer>
                  <span class="offer__radio" aria-hidden="true"></span>
                  <span class="offer__label">2 articles <span class="offer__badge">-5 %</span></span>
                  <span class="offer__total">{{ price_2 | money }}<small>TTC au total</small></span>
                </label>
              {%- endif -%}
              {%- if whop_3 != blank -%}
                <label class="offer">
                  <input type="radio" name="offer-{{ section.id }}" value="{{ whop_3 }}" data-whop-offer>
                  <span class="offer__radio" aria-hidden="true"></span>
                  <span class="offer__label">3 articles <span class="offer__badge">-10 %</span></span>
                  <span class="offer__total">{{ price_3 | money }}<small>TTC au total</small></span>
                </label>
              {%- endif -%}
            </fieldset>
          {%- endif -%}
          <a href="{{ whop_1 }}" class="btn btn--primary btn--block btn--lg" data-whop-buy data-main-buy rel="noopener">Acheter</a>
        </div>
      {%- else -%}
        {%- form 'product', product, id: 'ProductForm', class: 'product-form', data-product-form: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id data-price="{{ current_variant.price }}">

          {%- if show_variant_picker -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="variant-picker">
                <legend>{{ option.name | escape }}</legend>
                <div class="variant-picker__options">
                  {%- for value in option.values -%}
                    <label>
                      <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" data-option-index="{{ forloop.parentloop.index0 }}"{% if option.selected_value == value %} checked{% endif %}>
                      <span>{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
            <script type="application/json" data-variants-json>
              [{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price }},"available":{{ v.available }},"media":{{ v.featured_media.id | default: 0 }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
            </script>
          {%- endif -%}

          {%- if show_offers -%}
            <fieldset class="offers" data-offers>
              <legend>Choisis ton offre</legend>
              <label class="offer is-selected">
                <input type="radio" name="offer" value="1" data-offer checked>
                <span class="offer__radio" aria-hidden="true"></span>
                <span class="offer__label">1 article</span>
                <span class="offer__total" data-offer-total="1">{{ price | money }}<small>TTC</small></span>
              </label>
              <label class="offer">
                <input type="radio" name="offer" value="2" data-offer>
                <span class="offer__radio" aria-hidden="true"></span>
                <span class="offer__label">2 articles <span class="offer__badge">-5 %</span></span>
                <span class="offer__total" data-offer-total="2">{{ price_2 | money }}<small>TTC au total</small></span>
              </label>
              <label class="offer">
                <input type="radio" name="offer" value="3" data-offer>
                <span class="offer__radio" aria-hidden="true"></span>
                <span class="offer__label">3 articles <span class="offer__badge">-10 %</span></span>
                <span class="offer__total" data-offer-total="3">{{ price_3 | money }}<small>TTC au total</small></span>
              </label>
            </fieldset>
          {%- endif -%}

          <div class="buy-row">
            <div class="qty">
              <button type="button" data-qty-minus aria-label="Diminuer la quantité">−</button>
              <label for="Quantity-{{ section.id }}" class="visually-hidden">Quantité</label>
              <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" max="99" inputmode="numeric" data-qty-input>
              <button type="button" data-qty-plus aria-label="Augmenter la quantité">+</button>
            </div>
          </div>
          {%- if show_offers -%}
            <p class="buy-total">Total : <span data-buy-total>{{ price | money }}</span> TTC</p>
          {%- endif -%}
          <button type="submit" name="add" class="btn btn--primary btn--block btn--lg" data-add-to-cart data-main-buy{% unless current_variant.available %} disabled{% endunless %}>
            {%- if current_variant.available -%}Ajouter au panier{%- else -%}Épuisé{%- endif -%}
          </button>
          <p class="form-message form-message--error" data-form-error hidden></p>
        {%- endform -%}
      {%- endif -%}

      <div style="margin-top:12px">{%- render 'payment-means' -%}</div>

      <ul class="reassure" role="list">
        <li>{%- render 'icon', name: 'truck' -%}<span>{{ settings.free_shipping_text | default: 'Livraison suivie' | escape }}</span></li>
        <li>{%- render 'icon', name: 'return' -%}<span>Retours sous 14 jours</span></li>
        <li>{%- render 'icon', name: 'lock' -%}<span>Paiement sécurisé</span></li>
      </ul>

      <details class="accordion" open>
        <summary>Description</summary>
        <div class="accordion__content">
          {%- if product.description != blank -%}{{ product.description }}{%- endif -%}
          {%- if vigilance != blank -%}<p class="notice"><strong>Bon à savoir :</strong> {{ vigilance }}</p>{%- endif -%}
        </div>
      </details>

      <details class="accordion">
        <summary>Caractéristiques</summary>
        <div class="accordion__content">
          <ul class="spec-list">{%- render 'product-text', product: product, field: 'specs' -%}</ul>
        </div>
      </details>

      <details class="accordion">
        <summary>Livraison et retours</summary>
        <div class="accordion__content">
          {%- if mf.delais_livraison != blank and mf.delais_livraison.value contains 'COMPLÉTER' -%}{%- assign has_delay = false -%}{%- elsif mf.delais_livraison != blank -%}{%- assign has_delay = true -%}{%- else -%}{%- assign has_delay = false -%}{%- endif -%}
          {%- if has_delay -%}
            <p><strong>Livraison :</strong> {{ mf.delais_livraison.value | escape }}</p>
          {%- else -%}
            <p><strong>Livraison :</strong> les délais de livraison vers la France sont détaillés sur notre page <a href="/pages/livraison-et-retours">Livraison et retours</a>.</p>
          {%- endif -%}
          <p><strong>Retours :</strong> tu as 14 jours après réception pour changer d'avis. <a href="/pages/politique-de-retour">Voir la politique de retour</a>.</p>
          <p><a href="/pages/retractation" class="withdraw-btn withdraw-btn--red">Se rétracter du contrat</a></p>
        </div>
      </details>

      <details class="accordion">
        <summary>Informations sur le fabricant</summary>
        <div class="accordion__content">
          <p><strong>Nom du fabricant :</strong> {{ mf.fabricant_nom.value | default: '[À COMPLÉTER]' | escape }}</p>
          <p><strong>Adresse :</strong> {{ mf.fabricant_adresse.value | default: '[À COMPLÉTER]' | escape }}</p>
          <p><strong>Personne responsable dans l'UE :</strong> {{ mf.fabricant_responsable_ue.value | default: '[À COMPLÉTER]' | escape }}</p>
        </div>
      </details>
    </div>
  </div>

  {%- comment -%} ===== Questions fréquentes du produit ===== {%- endcomment -%}
  <div class="section--tight" style="margin-top:40px">
    <h2 class="section-title">Questions fréquentes</h2>
    <div class="faq" style="margin-top:20px">
      {%- render 'product-text', product: product, field: 'faq' -%}
      <details class="accordion"><summary>Quels sont les délais de livraison ?</summary><div class="accordion__content"><p>Les délais réels sont indiqués sur la page <a href="/pages/livraison-et-retours">Livraison et retours</a>. Consulte-la avant de commander, surtout à l'approche de Noël.</p></div></details>
      <details class="accordion"><summary>Puis-je le retourner ?</summary><div class="accordion__content"><p>Oui, tu as 14 jours après réception pour changer d'avis. Utilise le bouton « Se rétracter du contrat » en bas de chaque page.</p></div></details>
      <details class="accordion"><summary>Le prix affiché est-il le prix final ?</summary><div class="accordion__content"><p>Le prix est affiché TTC. Les éventuels frais de livraison sont indiqués avant le paiement.</p></div></details>
    </div>
  </div>
</section>

{%- comment -%} ===== Barre d'achat collée en bas (mobile) ===== {%- endcomment -%}
<div class="sticky-buy" data-sticky-buy>
  <div class="sticky-buy__info">
    <div class="sticky-buy__title">{{ product.title | escape }}</div>
    <div class="sticky-buy__price">{{ price | money }} TTC</div>
  </div>
  {%- if use_whop -%}
    <a href="{{ whop_1 }}" class="btn btn--primary" data-whop-buy rel="noopener">Acheter</a>
  {%- else -%}
    <button type="button" class="btn btn--primary" data-sticky-add{% unless current_variant.available %} disabled{% endunless %}>Ajouter au panier</button>
  {%- endif -%}
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "offers": {
      "@type": "Offer",
      "price": {{ price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ request.origin | append: product.url | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Fiche produit",
  "settings": [
    { "type": "checkbox", "id": "show_offers", "label": "Afficher les offres de quantité (-5 % / -10 %)", "default": true, "info": "Obligatoire : crée les remises automatiques correspondantes dans Remises (2 articles -5 %, 3 articles -10 %), sinon le prix payé ne correspondra pas. En mode Whop, les offres s'affichent seulement si les liens Whop 2 et 3 articles sont renseignés." }
  ]
}
{% endschema %}
