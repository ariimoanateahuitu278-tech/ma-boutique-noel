{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign mf = product.metafields.custom
  assign whop_1 = mf.lien_whop.value
  assign whop_2 = mf.lien_whop_2.value
  assign whop_3 = mf.lien_whop_3.value
  assign use_whop = false
  if settings.checkout_mode == 'whop' and whop_1 != blank
    assign use_whop = true
  endif

  assign show_offers = section.settings.show_offers
  if use_whop
    if whop_2 == blank and whop_3 == blank
      assign show_offers = false
    endif
  endif

  comment
    Sélecteur de variantes : uniquement si chaque variante existe vraiment avec sa propre photo.
  endcomment
  assign show_variant_picker = false
  unless product.has_only_default_variant
    assign show_variant_picker = true
    for v in product.variants
      if v.featured_media == blank
        assign show_variant_picker = false
      endif
    endfor
  endunless

  assign price = current_variant.price
  assign price_2 = price | times: 2 | times: 0.95 | round
  assign price_3 = price | times: 3 | times: 0.90 | round
  assign offer_img = product.featured_image

  capture benefits_raw
    render 'product-text', product: product, field: 'benefits'
  endcapture
  assign benefits = benefits_raw | strip | split: '~~'
-%}

{%- render 'garland', class: 'product__garland' -%}

<section class="product page-width" data-product-section data-section-id="{{ section.id }}">
  <div class="product__grid">

    {%- comment -%} ===== Colonne gauche : galerie (miniatures en colonne sur ordinateur) ===== {%- endcomment -%}
    <div class="product__gallery gallery{% if product.media.size > 1 %} gallery--has-thumbs{% endif %}" data-gallery>
      <div class="gallery__main">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="gallery__slide{% if media.id == current_variant.featured_media.id or forloop.first and current_variant.featured_media == blank %} is-active{% endif %}" data-slide data-media-id="{{ media.id }}"{% if media.media_type == 'image' %} data-zoom{% endif %}>
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- else -%}{%- assign img_loading = 'lazy' -%}{%- endif -%}
                  {{ media | image_url: width: 1400 | image_tag: loading: img_loading, widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 560px, 100vw', alt: media.alt | default: product.title }}
                {%- when 'video' -%}
                  {{ media | media_tag: image_size: '1200x', controls: true, playsinline: true, preload: 'none' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
          <span class="gallery__loupe" aria-hidden="true" title="Passe la souris sur la photo pour zoomer">{%- render 'icon', name: 'search' -%}</span>
          {%- if product.media.size > 1 -%}
            <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="Photo précédente">{%- render 'icon', name: 'chevron-left' -%}</button>
            <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="Photo suivante">{%- render 'icon', name: 'chevron-right' -%}</button>
          {%- endif -%}
        {%- else -%}
          <div class="gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <ul class="gallery__thumbs" role="list">
          {%- for media in product.media -%}
            <li>
              <button type="button" class="gallery__thumb" data-thumb="{{ forloop.index0 }}" aria-label="Voir la photo {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>
                {{ media.preview_image | image_url: width: 200, height: 200, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} ===== Colonne droite : zone d'achat ===== {%- endcomment -%}
    <div class="product__info">
      <span class="eyebrow">{%- render 'product-text', product: product, field: 'eyebrow' -%}</span>
      <div class="product__title-row">
        <h1 class="product__title">{{ product.title | escape }}</h1>
        {%- render 'baubles', class: 'baubles--dark baubles--small', count: 5 -%}
      </div>

      <div class="product__price">
        <span class="product__price-amount" data-unit-price>{{ price | money }}</span>
        <span class="product__price-tax">{{ settings.tax_label | default: 'TTC' }}</span>
      </div>

      <ul class="benefits" role="list">
        {%- for b in benefits limit: 8 -%}
          {%- assign t = b | strip -%}
          {%- if t != blank -%}
            <li><span class="check">{%- render 'icon', name: 'check' -%}</span><span>{{ t }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if use_whop -%}
        {%- comment -%} Paiement via les liens Whop du produit {%- endcomment -%}
        <div data-whop-form>
          {%- if show_offers -%}
            <fieldset class="offers">
              <legend>Choisis ton offre</legend>
              <div class="offers__grid">
                {%- render 'offer-card', n: 1, value: whop_1, name: section.id, total: price, image: offer_img, product: product, checked: true, whop: true -%}
                {%- if whop_2 != blank -%}{%- render 'offer-card', n: 2, value: whop_2, name: section.id, total: price_2, image: offer_img, product: product, whop: true -%}{%- endif -%}
                {%- if whop_3 != blank -%}{%- render 'offer-card', n: 3, value: whop_3, name: section.id, total: price_3, image: offer_img, product: product, whop: true -%}{%- endif -%}
              </div>
            </fieldset>
          {%- endif -%}
          <a href="{{ whop_1 }}" class="btn btn--primary btn--block btn--lg" data-whop-buy data-main-buy rel="noopener">Acheter</a>
        </div>
      {%- else -%}
        {%- form 'product', product, id: 'ProductForm', class: 'product-form', data-product-form: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id data-price="{{ current_variant.price }}">
          <input type="hidden" name="quantity" value="1" data-qty-input>

          {%- if show_variant_picker -%}
            {%- for option in product.options_with_values -%}
              <fieldset class="variant-picker">
                <legend>{{ option.name | escape }}</legend>
                <div class="variant-picker__options">
                  {%- for value in option.values -%}
                    <label>
                      <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}" data-option-index="{{ forloop.parentloop.index0 }}"{% if option.selected_value == value %} checked{% endif %}>
                      <span>{{ value | escape }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
            <script type="application/json" data-variants-json>
              [{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price }},"available":{{ v.available }},"media":{{ v.featured_media.id | default: 0 }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
            </script>
          {%- endif -%}

          {%- if show_offers -%}
            <fieldset class="offers" data-offers>
              <legend>Choisis ton offre</legend>
              <div class="offers__grid">
                {%- render 'offer-card', n: 1, value: 1, name: section.id, total: price, image: offer_img, product: product, checked: true -%}
                {%- render 'offer-card', n: 2, value: 2, name: section.id, total: price_2, image: offer_img, product: product -%}
                {%- render 'offer-card', n: 3, value: 3, name: section.id, total: price_3, image: offer_img, product: product -%}
              </div>
            </fieldset>
          {%- endif -%}

          <button type="submit" name="add" class="btn btn--primary btn--block btn--lg" data-add-to-cart data-main-buy{% unless current_variant.available %} disabled{% endunless %}>
            {%- if current_variant.available -%}Ajouter au panier{%- else -%}Épuisé{%- endif -%}
          </button>
          <p class="form-message form-message--error" data-form-error hidden></p>
        {%- endform -%}
      {%- endif -%}

      <div style="margin-top:12px">{%- render 'payment-means' -%}</div>
      {%- render 'reassure-cards' -%}
    </div>
  </div>
</section>

{%- comment -%} ===== Barre d'achat : en bas sur mobile, en haut sur ordinateur après la galerie ===== {%- endcomment -%}
<div class="sticky-buy" data-sticky-buy>
  <div class="page-width sticky-buy__inner">
    {%- if offer_img -%}{{ offer_img | image_url: width: 120, height: 120, crop: 'center' | image_tag: class: 'sticky-buy__img', loading: 'lazy', alt: '' }}{%- endif -%}
    <div class="sticky-buy__info">
      <div class="sticky-buy__title">{{ product.title | escape }}</div>
      <div class="sticky-buy__price">{{ price | money }} TTC</div>
    </div>
    {%- if use_whop -%}
      <a href="{{ whop_1 }}" class="btn btn--primary" data-whop-buy rel="noopener">Acheter</a>
    {%- else -%}
      <button type="button" class="btn btn--primary" data-sticky-add{% unless current_variant.available %} disabled{% endunless %}>Ajouter au panier</button>
    {%- endif -%}
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "offers": {
      "@type": "Offer",
      "price": {{ price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ request.origin | append: product.url | json }}
    }
  }
</script>

{% schema %}
{
  "name": "Fiche produit",
  "settings": [
    { "type": "checkbox", "id": "show_offers", "label": "Afficher les offres de quantité (-5 % / -10 %)", "default": true, "info": "Obligatoire : crée les remises automatiques correspondantes dans Remises (2 articles -5 %, 3 articles -10 %), sinon le prix payé ne correspondra pas. En mode Whop, les offres s'affichent seulement si les liens Whop 2 et 3 articles sont renseignés." }
  ]
}
{% endschema %}
