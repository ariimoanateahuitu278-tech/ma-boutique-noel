{%- comment -%} Carte produit (accueil, collection, recherche, « Vous aimerez aussi »). Bouton toujours « Voir le produit ». {%- endcomment -%}
{%- liquid
  assign first = card_product.media[0]
  assign second = card_product.media[1]
  assign img_loading = loading | default: 'lazy'
-%}
<article class="card" data-reveal>
  <a href="{{ card_product.url }}" class="card__media{% if second and second.media_type == 'image' %} card__media--has-second{% endif %}" tabindex="-1" aria-hidden="true">
    {%- if first -%}
      {{ first.preview_image | image_url: width: 900 | image_tag: loading: img_loading, widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 380px, (min-width: 560px) 50vw, 100vw', class: 'card__img--first', alt: first.alt | default: card_product.title }}
      {%- if second and second.media_type == 'image' -%}
        {{ second.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 380px, (min-width: 560px) 50vw, 100vw', class: 'card__img--second', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </a>
  <div class="card__body">
    <div class="card__top">
      <span class="tag-gift">{%- render 'icon', name: 'gift' -%}<span>Idée cadeau</span></span>
      <button type="button" class="heart" data-wishlist="{{ card_product.handle }}" aria-pressed="false" aria-label="Ajouter {{ card_product.title | escape }} à mes coups de cœur">{%- render 'icon', name: 'heart' -%}</button>
    </div>
    <h3 class="card__title"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
    <p class="card__price">{{ card_product.price | money }} <small>TTC</small></p>
    <a href="{{ card_product.url }}" class="btn btn--primary btn--block">Voir le produit</a>
  </div>
</article>
